<?xml version="1.0" encoding="UTF-8"?>
<!-- 仅供本机伪终端测试使用：禁用 UDP，避免 CI 沙箱依赖网络接口。 -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>kiwi_test_shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="kiwi_test_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>kiwi_test_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
