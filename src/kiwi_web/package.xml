<?xml version="1.0"?>
<package format="3">
  <name>kiwi_web</name>
  <version>0.1.0</version>
  <description>Local browser control, map editing and ROS 2 navigation for Kiwi.</description>
  <maintainer email="maintainer@example.com">Kiwi maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-aiohttp</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-psutil</exec_depend>
  <exec_depend>kiwi_navigation</exec_depend>
  <exec_depend>kiwi_slam</exec_depend>
  <exec_depend>kiwi_base</exec_depend>
  <exec_depend>kiwi_platform</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rcl_interfaces</test_depend>
  <export><build_type>ament_cmake</build_type></export>
