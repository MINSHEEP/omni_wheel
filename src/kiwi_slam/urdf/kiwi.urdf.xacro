<?xml version="1.0"?>
<!-- Kiwi 结构和 TF 的唯一描述入口：结构尺寸读 YAML，传感器安装外参只在本文件标定。 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kiwi_base">
  <xacro:arg name="hardware_config" default="$(find kiwi_base)/config/kiwi_base.yaml"/>
  <xacro:property name="hardware" value="${xacro.load_yaml('$(arg hardware_config)')}"/>
  <xacro:property name="base_params" value="${hardware['kiwi_base_node']['ros__parameters']}"/>
  <xacro:property name="model" value="${hardware['kiwi_robot_model']['ros__parameters']}"/>

  <xacro:property name="wheel_radius" value="${base_params['wheel_radius_m']}"/>
  <xacro:property name="wheel_center" value="${base_params['wheel_center_distance_m']}"/>
  <xacro:property name="sin60" value="0.866025403784"/>

  <!-- 安装外参标定区：ROS 坐标为 x 前、y 左、z 上，角度单位 rad。 -->
  <!--
    当前底盘对外坐标相对原轮组解析式坐标逆时针旋转 180°。
    C 板 IMU 原测量位置为原坐标的前方 11.5 mm、右侧 149 mm，转换到当前坐标后取反；
    IMU 若保持水平且板端 x 轴与原轮组方向一致，静态 yaw 同样为 180°。
  -->
  <xacro:property name="chassis_imu_xyz" value="-0.0115 0.149 0.0"/>
  <xacro:property name="chassis_imu_rpy" value="0.0 0.0 3.141592653589793"/>
  <!-- Mid-360S 整机安装位姿：当前仅高度已知，雷达坐标轴相对底盘旋转 180°。 -->
  <xacro:property name="lidar_xyz" value="0.0 0.0 0.20"/>
  <xacro:property name="lidar_rpy" value="0.0 0.0 3.141592653589793"/>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="${model['base_radius_m']}" length="${model['base_height_m']}"/></geometry>
      <material name="base_gray"><color rgba="0.25 0.28 0.30 1.0"/></material>
    </visual>
    <collision><geometry><cylinder radius="${model['base_radius_m']}" length="${model['base_height_m']}"/></geometry></collision>
    <inertial>
      <mass value="${model['base_mass_kg']}"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="${model['base_inertia_kg_m2'][0]}" ixy="0" ixz="0"
               iyy="${model['base_inertia_kg_m2'][1]}" iyz="0"
               izz="${model['base_inertia_kg_m2'][2]}"/>
    </inertial>
  </link>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${model['base_z_m']}" rpy="0 0 0"/>
  </joint>

  <!-- C 板 BMI088 的独立坐标系；名称与 Mid-360S 内置 IMU 明确区分。 -->
  <link name="chassis_imu_link"/>
  <joint name="base_link_to_chassis_imu" type="fixed">
    <parent link="base_link"/><child link="chassis_imu_link"/>
    <origin xyz="${chassis_imu_xyz}" rpy="${chassis_imu_rpy}"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${model['lidar_visual_radius_m']}" length="${model['lidar_visual_height_m']}"/></geometry>
      <material name="lidar_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
    </visual>
  </link>
  <joint name="base_link_to_lidar" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="${lidar_xyz}" rpy="${lidar_rpy}"/>
  </joint>

  <!-- Livox 驱动固定发布 livox_frame；与项目统一雷达安装入口 lidar_link 重合。 -->
  <link name="livox_frame"/>
  <joint name="lidar_link_to_livox_frame" type="fixed">
    <parent link="lidar_link"/><child link="livox_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 轮组几何与运动学解析式同步旋转 180°，保持轮序和 TF 模型使用同一坐标约定。 -->
  <link name="motor_link_1"/>
  <joint name="base_to_motor_1" type="fixed">
    <parent link="base_link"/><child link="motor_link_1"/>
    <origin xyz="${0.5 * wheel_center} ${-sin60 * wheel_center} 0" rpy="0 0 -1.0471975512"/>
  </joint>
  <link name="wheel_link_1">
    <visual><origin rpy="0 1.57079632679 0"/><geometry><cylinder radius="${wheel_radius}" length="${model['wheel_width_m']}"/></geometry></visual>
    <collision><origin rpy="0 1.57079632679 0"/><geometry><cylinder radius="${wheel_radius}" length="${model['wheel_width_m']}"/></geometry></collision>
  </link>
  <joint name="wheel_joint_1" type="continuous">
    <parent link="motor_link_1"/><child link="wheel_link_1"/><axis xyz="0 1 0"/>
  </joint>

  <link name="motor_link_2"/>
  <joint name="base_to_motor_2" type="fixed">
    <parent link="base_link"/><child link="motor_link_2"/>
    <origin xyz="${-wheel_center} 0 0" rpy="0 0 3.14159265359"/>
  </joint>
  <link name="wheel_link_2">
    <visual><origin rpy="0 1.57079632679 0"/><geometry><cylinder radius="${wheel_radius}" length="${model['wheel_width_m']}"/></geometry></visual>
    <collision><origin rpy="0 1.57079632679 0"/><geometry><cylinder radius="${wheel_radius}" length="${model['wheel_width_m']}"/></geometry></collision>
  </link>
  <joint name="wheel_joint_2" type="continuous">
    <parent link="motor_link_2"/><child link="wheel_link_2"/><axis xyz="0 1 0"/>
  </joint>

  <link name="motor_link_3"/>
  <joint name="base_to_motor_3" type="fixed">
    <parent link="base_link"/><child link="motor_link_3"/>
    <origin xyz="${0.5 * wheel_center} ${sin60 * wheel_center} 0" rpy="0 0 1.0471975512"/>
  </joint>
  <link name="wheel_link_3">
    <visual><origin rpy="0 1.57079632679 0"/><geometry><cylinder radius="${wheel_radius}" length="${model['wheel_width_m']}"/></geometry></visual>
    <collision><origin rpy="0 1.57079632679 0"/><geometry><cylinder radius="${wheel_radius}" length="${model['wheel_width_m']}"/></geometry></collision>
  </link>
  <joint name="wheel_joint_3" type="continuous">
    <parent link="motor_link_3"/><child link="wheel_link_3"/><axis xyz="0 1 0"/>
  </joint>
</robot>
